# Dashboard env template — copy to web/.env for local development.
#
# All three are NEXT_PUBLIC_*, so they are inlined into the client bundle at
# build time: `next dev` reads them per start, while a production build
# (`pnpm start` -> `next build`) freezes them, so re-run that build after
# changing a value here.
#
# Ports match the pinned local stack (see CONTRIBUTING.md). `pnpm dev` runs the
# Node API against the dev Postgres:
#   API       http://localhost:8787  (`pnpm dev`)
#   delivery  http://localhost:8788  (`pnpm dev:all`)
#   web       http://localhost:3000

NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/api
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:8787/api/auth
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
