{
  "name": "@openvod/uploader",
  "version": "0.1.1",
  "description": "OpenVOD video uploader SDK with multipart upload support",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "~3.2.7"
  },
  "keywords": [
    "video",
    "upload",
    "multipart",
    "openvod",
    "streaming"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visheshgubrani/vod.git"
  },
  "homepage": "https://github.com/visheshgubrani/vod/tree/main/sdk#readme",
  "bugs": {
    "url": "https://github.com/visheshgubrani/vod/issues"
  }
}