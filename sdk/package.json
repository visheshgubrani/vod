{
  "name": "@clipmux/uploader",
  "version": "0.2.0",
  "description": "ClipMux uploader SDK — windowed multipart uploads, resumable sessions, typed errors",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": {
        "import": "./dist/index.d.ts",
        "require": "./dist/index.d.cts"
      },
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "~3.2.7"
  },
  "keywords": [
    "video",
    "upload",
    "multipart",
    "resumable",
    "clipmux",
    "vod",
    "streaming"
  ],
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visheshgubrani/vod.git"
  },
  "homepage": "https://github.com/visheshgubrani/vod/tree/main/sdk#readme",
  "bugs": {
    "url": "https://github.com/visheshgubrani/vod/issues"
  }
}
