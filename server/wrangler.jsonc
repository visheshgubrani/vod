{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "vod-api",
	"main": "src/index.ts",
	"compatibility_date": "2025-09-27",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	"analytics_engine_datasets": [
		{
			"binding": "PLAYBACK_ANALYTICS",
			"dataset": "playback_events",
		},
	],
	// Bind a custom domain after first deploy, e.g.:
	// "routes": [{ "pattern": "api.example.com", "custom_domain": true }],

	/**
	 * Background maintenance: transcode job sweeps, webhook retries, and
	 * storage reclamation for deleted videos.
	 *
	 * Enabled by default because leaving it off is not inert — webhook retries
	 * and byte reclamation stop too, so deleted videos keep costing storage.
	 * Also requires SWEEP_ENABLED=true in the environment (see .dev.vars.example).
	 * `GET /health/config` reports whether it is on.
	 */
	"triggers": { "crons": ["*/15 * * * *"] },
}
