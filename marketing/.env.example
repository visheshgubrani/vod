# Public marketing deployment configuration.
# The strict production build rejects missing values. These URLs are intentionally
# deployment configuration: the app does not create form APIs or invent destinations.
MARKETING_CANONICAL_ORIGIN=https://clipmux.com
MARKETING_DOCS_URL=https://docs.clipmux.com
MARKETING_QUICKSTART_URL=https://docs.clipmux.com/quickstart
MARKETING_GITHUB_URL=https://github.com/visheshgubrani/vod
MARKETING_MANAGED_FORM_URL=https://forms.example.com/clipmux-managed
MARKETING_ENTERPRISE_FORM_URL=https://forms.example.com/clipmux-enterprise
MARKETING_PRIVACY_URL=https://clipmux.com/privacy

# Hero recording. All three default to the files in public/media, so a
# deployment without a CDN still renders. Point them at a bucket or CDN when the
# clips are served from elsewhere.
MARKETING_HERO_VIDEO_URL=/media/hero-1080.mp4
MARKETING_HERO_VIDEO_MOBILE_URL=/media/hero-720.mp4
MARKETING_HERO_POSTER_URL=/media/hero-poster.jpg
