# Copy this file to .env.local and fill in your deployment's values.
#
#   cp .env.example .env.local
#
# Next.js loads .env.local automatically. It is gitignored by the root
# .gitignore (`.env*`), and .env.example is the only template that is committed.

# ── Server-side (never exposed to the browser) ──────────────────────────────
# Your ClipMux API key (`sk_live_…`). It must have NO NEXT_PUBLIC_ prefix:
# only the route handlers under app/api/** can read it, which is what keeps the
# key out of the browser bundle.
CLIPMUX_API_KEY=sk_live_replace_me

# Your ClipMux API origin, WITHOUT the /v1 suffix — both SDKs append it.
# Local development: `pnpm dev` serves the API on :8787.
CLIPMUX_API_URL=http://localhost:8787

# Webhook signing secret for POST /api/webhooks/clipmux (`whsec_…`).
# Find it in your deployment's webhook settings / server/.dev.vars.
CLIPMUX_WEBHOOK_SECRET=whsec_replace_me

# ── Browser-side ────────────────────────────────────────────────────────────
# The API origin the uploader SDK uploads to. NEXT_PUBLIC_ variables are inlined
# into the client bundle at build time, so this must not be a secret — and the
# value must be identical to CLIPMUX_API_URL, otherwise the browser will try to
# upload to a different deployment than the one that minted its token.
NEXT_PUBLIC_CLIPMUX_API_URL=http://localhost:8787
