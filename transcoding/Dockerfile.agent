# Self-hosted transcoding agent.
#
# Two layers, deliberately separated:
#
#   * the *engine* (this image) — FFmpeg, Shaka Packager, the pipeline and the CLI
#   * the *host* — GPU drivers, the media mounts, and the scratch volume
#
# The engine is identical across CPU, NVIDIA and AMD. That is the point of the
# hardware-agnostic encoding seam: a machine with no accelerator and a machine
# with two of them run the same image, and the capability probe decides what to
# actually use. The GPU variants are *runtime* changes (device passthrough and
# driver access), not build-time ones, which is what keeps `doctor` honest —
# whatever it reports is about the machine it is running on right now.
#
# FFmpeg is NOT a distribution package here. It is built from source by the one
# shared recipe (transcoding/toolchain/build_ffmpeg.sh) that the Modal runner
# image uses too, so both halves of the system encode with the same bytes. The
# distribution build could not do the job: its `scale_cuda` has no `format`
# option, and the NVENC scaling path passes `scale_cuda=W:H:format=yuv420p`. The
# recipe also pins every version and checksum in transcoding/toolchain/versions.env
# and finishes by running verify_toolchain.sh, so an image that lost a codec
# fails to BUILD instead of failing on a customer's job.
#
# Build (context = repository root; the recipe reads boto3/toolchain/ from it):
#   docker build -f transcoding/Dockerfile.agent -t clipmux-transcoder .
#
# Run (CPU):
#   docker run --rm -it \
#     -v /srv/media:/media:ro \
#     -v clipmux-scratch:/var/lib/clipmux-transcoder \
#     -e CLIPMUX_API_URL=https://api.example.com \
#     -e CLIPMUX_ROOTS=media:/media \
#     clipmux-transcoder doctor --full
#
# Run (NVIDIA): add
#   --gpus 'all,capabilities=compute,utility,video'
# The `video` capability is the one that is easy to miss: without it the driver
# is present but no NVENC session can be created, and an encode probe is the only
# thing that reveals it. The driver must also be >= 530.41.03 — that is the floor
# of the NVENC headers this image was compiled against (see versions.env), and it
# is a RUNTIME property, never asserted at build time.
#
# Run (AMD): add
#   --device /dev/dri/renderD128 --group-add video
# VAAPI is AMD's supported Linux path; the render device must be passed through
# and the agent's user must be able to open it.
#
# Ubuntu 24.04 + Python 3.12 to match the managed Modal image (versions.env
# TARGET_UBUNTU_VERSION / PYTHON_VERSION): the same engine, the same FFmpeg, the
# same interpreter generation on both sides of the seam.

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# Every RUN below sources the shared recipe's bash arrays (package lists,
# versions). /bin/sh on Ubuntu is dash, which cannot parse them — and failing
# there is a build error that only shows up in the image build.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

# Toolchain inputs come from transcoding/toolchain/versions.env (copied below),
# which is the single source of truth: this file names no version, URL or digest
# of its own. build_ffmpeg.sh refuses to build if a hash is blank, and the
# packager is checksum-verified against the same file.
ARG FFMPEG_PREFIX=/usr/local

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CLIPMUX_SCRATCH_DIR=/var/lib/clipmux-transcoder/scratch \
    CLIPMUX_JOURNAL=/var/lib/clipmux-transcoder/journal.sqlite \
    CLIPMUX_ROOTS_FILE=/etc/clipmux-transcoder/roots.json \
    CLIPMUX_FFMPEG=/usr/local/bin/ffmpeg \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH

# ── Shared toolchain recipe ──────────────────────────────────────────────────
# The package lists live in the recipe directory so this image and the Modal
# image cannot drift. Only the recipe files are copied here; /app arrives later.
COPY transcoding/toolchain/ /tmp/clipmux-toolchain/

# Build deps, the source build, then the checksum-pinned packager. All of this is
# one layer so the build-only packages can be purged in the very next step
# without leaving an intermediate layer behind.
#
# The CUDA toolkit is deliberately absent: FFmpeg 9.0.1 builds the CUDA filters
# with clang to PTX (--enable-cuda-llvm), so nvcc and libcuda are not needed to
# produce `scale_cuda` — see transcoding/toolchain/apt-packages.env. Modern clang
# rejects FFmpeg's default `--cuda-gpu-arch=sm_30`, which is why the recipe
# passes an explicit sm_75 baseline that newer drivers JIT forward.
RUN set -eux; \
    . /tmp/clipmux-toolchain/versions.env; \
    . /tmp/clipmux-toolchain/apt-packages.env; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      "${CLIPMUX_BUILD_PACKAGES[@]}" \
      python3 \
      tini curl ca-certificates; \
    bash /tmp/clipmux-toolchain/build_ffmpeg.sh "${FFMPEG_PREFIX}"; \
    curl -fsSL "${SHAKA_URL}" -o /usr/local/bin/packager; \
    echo "${SHAKA_SHA256}  /usr/local/bin/packager" | sha256sum -c -; \
    chmod +x /usr/local/bin/packager; \
    packager --version

# ── Drop the build-only packages, keep what FFmpeg links against ─────────────
# The runtime list is explicit rather than "whatever apt leaves behind": a purge
# that quietly takes libzimg with it produces an image whose ffmpeg dies at the
# first zscale, which is exactly the class of failure this stage exists to catch.
# verify_toolchain.sh runs AFTER the purge, on the pruned image, so the build
# cannot pass by accident.
RUN set -eux; \
    . /tmp/clipmux-toolchain/apt-packages.env; \
    apt-get purge -y "${CLIPMUX_BUILD_PACKAGES[@]}" xz-utils; \
    apt-get autoremove -y; \
    apt-get install -y --no-install-recommends "${CLIPMUX_RUNTIME_PACKAGES[@]}"; \
    rm -rf /var/lib/apt/lists/*; \
    bash /tmp/clipmux-toolchain/verify_toolchain.sh \
      "${FFMPEG_PREFIX}/bin/ffmpeg" "${FFMPEG_PREFIX}/bin/ffprobe"

# ── The engine ───────────────────────────────────────────────────────────────
WORKDIR /app
COPY transcoding/ /app/

# The agent runs as uid 10001, so every module has to be readable by it. Git
# only records the executable bit, which means a file created with a restrictive
# umask on the build machine arrives here mode 600 and the CLI dies with
# "Permission denied" the first time it imports that module. Normalise instead of
# trusting the checkout.
RUN chmod -R a+rX /app

# A venv is the clean way to escape PEP 668 (Ubuntu 24.04 marks the system
# interpreter externally managed), and it keeps the engine's console script on
# PATH without touching the distribution's Python. `python3-venv` is installed
# here rather than earlier on purpose: the build-dependency purge above removes
# ensurepip with it, and the symptom is a venv error at this step.
#
# Runtime deps only: the agent never imports Modal, boto3 or Whisper. Installing
# them would add hundreds of megabytes to an image whose whole job is FFmpeg, and
# transcoding/toolchain/requirements-managed.lock is for the *managed* image, not
# this one. `--no-deps` is deliberate: pyproject declares `requests`, installed
# above, and nothing else — the engine must import with no optional packages
# present (tests/test_engine_isolation.py enforces it).
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3-venv \
 && rm -rf /var/lib/apt/lists/* \
 && python3 -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel \
 && /opt/venv/bin/pip install --no-cache-dir requests \
 && /opt/venv/bin/pip install --no-cache-dir --no-deps --no-build-isolation -e /app \
 && clipmux-transcoder version

# The recipe and its pins stay in the image: `clipmux-transcoder doctor` reports
# the FFmpeg it is actually running, and an operator debugging an old container
# needs the configure line that produced it. A copy, not a dependency — nothing
# at runtime reads /tmp.
RUN mkdir -p /opt/clipmux/toolchain \
 && cp /tmp/clipmux-toolchain/versions.env \
       /tmp/clipmux-toolchain/apt-packages.env \
       /tmp/clipmux-toolchain/build_ffmpeg.sh \
       /tmp/clipmux-toolchain/verify_toolchain.sh \
       /opt/clipmux/toolchain/ \
 && rm -rf /tmp/clipmux-toolchain \
 && ffmpeg -version | head -n 1 \
 && ffprobe -version | head -n 1 \
 && cat "${FFMPEG_PREFIX}/share/clipmux/toolchain.json" | head -n 5

# The agent runs unprivileged. It only ever *reads* the media mounts, so there is
# no reason for it to be able to write to them — and a container that cannot
# write to the owner's library cannot damage it.
RUN groupadd --gid 10001 clipmux \
 && useradd --uid 10001 --gid 10001 --create-home --shell /usr/sbin/nologin clipmux \
 && mkdir -p /var/lib/clipmux-transcoder/scratch /etc/clipmux-transcoder \
 && chown -R clipmux:clipmux /var/lib/clipmux-transcoder

# `video` covers both /dev/dri (AMD/Intel) and the NVIDIA device nodes, so a
# container that needs either can be started with --group-add video.
RUN groupadd --gid 44 video || true \
 && usermod -aG video clipmux

USER clipmux
VOLUME ["/var/lib/clipmux-transcoder"]

# tini reaps the FFmpeg processes the pipeline spawns. Without it a terminated
# encode can leave children holding the GPU session, which then makes the *next*
# job fail with a confusing "no free encoding session".
ENTRYPOINT ["/usr/bin/tini", "--", "clipmux-transcoder"]
CMD ["run"]

# Diagnostics are the default health check because "the container is up" says
# nothing about whether it can encode or reach the API.
HEALTHCHECK --interval=5m --timeout=2m --start-period=1m \
  CMD clipmux-transcoder --json doctor || exit 1
