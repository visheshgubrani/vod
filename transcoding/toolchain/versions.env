# syntax: shell assignments only — no logic, no command substitution, no exports.
#
# The single source of truth for the media toolchain that both managed images
# consume: the Modal runner image (`transcoding/main.py`) and the self-hosted
# agent image (`transcoding/Dockerfile.agent`). Nothing else may hard-code a
# version, a URL or a digest — `build_ffmpeg.sh` refuses to build if a hash is
# blank, and `verify_toolchain.sh` compares the installed FFmpeg against
# FFMPEG_VERSION, so a drift here surfaces as a failed build rather than as a
# subtly different encoding of every job.
#
# Source it, do not execute it:
#   set -a; . transcoding/toolchain/versions.env; set +a
#
# Why a source build at all: the distribution FFmpeg that used to be installed
# here (`apt-get install ffmpeg`) has `scale_cuda` without its `format` option —
# the option the NVIDIA scaling path passes to pin the surface format. That is a
# build-time property of FFmpeg's CUDA filters, so it can only be fixed by
# building them ourselves. See build_ffmpeg.sh for the exact configure line.

# ─── FFmpeg ──────────────────────────────────────────────────────────────────
FFMPEG_VERSION=9.0.1
FFMPEG_SHA256=cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz

# ─── nv-codec-headers (ffnvcodec) ────────────────────────────────────────────
# FFmpeg 9.0.1's configure requires `ffnvcodec >= 12.1.14.0`; 12.1.14.0 is also
# the header release that documents a Linux driver floor of 530.41.03, which is
# the floor the whole CUDA path in this project inherits. The pinned commit is
# the tag's commit, so a moved or re-tagged release cannot change the bytes.
# `make install PREFIX=/usr` is deliberate: it drops `ffnvcodec.pc` where
# pkg-config already looks.
NV_CODEC_HEADERS_VERSION=n12.1.14.0
# The commit is *provenance*; the sha256 is the *integrity* check, and they are
# different values. GitHub's codeload tarball for a commit is not byte-stable
# across compression changes, so the hash below is verified on download and the
# commit is recorded in the build manifest; if GitHub ever re-packs the archive,
# the build fails loudly instead of silently building a different tree.
NV_CODEC_HEADERS_SHA=1889e62e2d35ff7aa9baca2bceb14f053785e6f1
NV_CODEC_HEADERS_SHA256=e30d4791fd386de8b5c9f88dec781e546ec148b8808440dd421da5f26c2700ae
NV_CODEC_HEADERS_URL=https://github.com/FFmpeg/nv-codec-headers/archive/${NV_CODEC_HEADERS_SHA}.tar.gz
NV_CODEC_HEADERS_GIT=https://github.com/FFmpeg/nv-codec-headers

# ─── Shaka Packager ──────────────────────────────────────────────────────────
# Checksum-pinned: a packager that silently changes version changes the bytes
# every job produces, which is not something to discover from a diff.
SHAKA_VERSION=v3.2.0
SHAKA_SHA256=05af2e9ef5f12d58b9d615b7d31dc0eb61c32aee632c71965340b43c1556043e
SHAKA_URL=https://github.com/shaka-project/shaka-packager/releases/download/${SHAKA_VERSION}/packager-linux-x64

# ─── Managed base images ─────────────────────────────────────────────────────
# Modal runner: Ubuntu 24.04 + CUDA 12.9 + cuDNN 9 (faster-whisper/CT2 want
# CUDA 12 + cuDNN 9 at runtime; the toolkit itself is *not* needed at build
# time because FFmpeg's CUDA filters are compiled with clang to PTX).
# The digest is the manifest-list digest, pinned so `nvidia/cuda:12.9.2-...`
# cannot be re-pushed under us.
CUDA_BASE_IMAGE=nvidia/cuda:12.9.2-cudnn-runtime-ubuntu24.04
CUDA_BASE_IMAGE_DIGEST=sha256:070f8f2672df1b05b84c0409a5fd1d54ddfd646e5b9d8dee7878131271b563fc
CUDA_BASE_IMAGE_REF=${CUDA_BASE_IMAGE}@${CUDA_BASE_IMAGE_DIGEST}

# Self-hosted agent: Ubuntu 24.04 + the distribution's Python 3.12, in a venv
# (PEP 668 marks the system interpreter externally managed).
AGENT_BASE_IMAGE=ubuntu:24.04
TARGET_UBUNTU_VERSION=24.04
TARGET_UBUNTU_CODENAME=noble

# ─── Python (managed images) ─────────────────────────────────────────────────
# Modal's managed image and the agent image are both Python 3.12, which is what
# transcoding/toolchain/requirements-managed.lock is resolved against.
PYTHON_VERSION=3.12
