# syntax: shell assignments only — no logic, no commands. Source it.
#
# Ubuntu 24.04 (noble) packages needed to BUILD the shared FFmpeg recipe and the
# runtime shared libraries it links against afterwards. The two lists are split
# because the agent image purges the build-only ones to shrink the image; the
# runtime list is what must survive that purge so `ffmpeg` still loads.
#
# Keep the runtime list honest: every entry is a library FFmpeg links against,
# named by the *runtime* package so the `-dev` package does not have to stay.
# `build_ffmpeg.sh` cross-checks its own `ldd` output against this list and warns
# about anything missing, which is the failure that otherwise only shows up the
# first time a container starts.

# Why the CUDA toolkit is absent from both lists
# ----------------------------------------------
# FFmpeg 9.0.1's configure declares
#     scale_cuda_filter_deps_any="cuda_nvcc cuda_llvm"
# so the CUDA-only filters (scale_cuda, thumbnail_cuda, transpose_cuda, ...)
# need either nvcc or --enable-cuda-llvm. With --enable-cuda-llvm the configure
# defaults nvcc to clang and compiles device code with
#     -S -nocudalib -nocudainc --cuda-device-only -include compat/cuda/cuda_runtime.h
# i.e. to PTX from clang's own CUDA headers. No toolkit, no nvcc, no libcuda at
# build time — only clang and the ffnvcodec headers from nv-codec-headers.
# The driver is reached by dlopen at RUNTIME, which is exactly why hardware
# usability is a runtime probe and never asserted during the build.

# Build-only (headers, compilers, assemblers — purged in the agent image)
#   clang          the CUDA device-code compiler for --enable-cuda-llvm
#                  (FFmpeg's configure runs it as `nvcc` with --cuda-device-only)
#   pkg-config     locates ffnvcodec, x264, dav1d, opus, zimg and friends
#   nasm           assembler for x86-64 SIMD; FFmpeg 9.0.1's configure
#                  hard-fails on x86-64 without it (--disable-x86asm is not used)
#   yasm           legacy asm path, still probed on x86-64
#   lib*-dev       the external codecs and filters enabled in build_ffmpeg.sh
OPENVOD_BUILD_PACKAGES=(
  build-essential
  clang
  pkg-config
  nasm
  yasm
  ca-certificates
  curl
  xz-utils
  libx264-dev
  libx265-dev
  libvpx-dev
  libaom-dev
  libdav1d-dev
  libopus-dev
  libmp3lame-dev
  libvorbis-dev
  libwebp-dev
  libzimg-dev
  libass-dev
  libfreetype-dev
  libfribidi-dev
  libharfbuzz-dev
  libva-dev
  libdrm-dev
)

# Runtime (kept in every image that ships the built FFmpeg)
#   libdl/libpthread/libm are part of glibc — nothing to install.
#   The ffmpeg binary itself goes to /usr/local/lib and is found through
#   ldconfig (system prefix) or LD_LIBRARY_PATH (custom prefix).
OPENVOD_RUNTIME_PACKAGES=(
  # TLS roots. Kept deliberately: the agent talks to the API over HTTPS, and an
  # image whose system trust store was purged as a "build dependency" fails in
  # ways that look like a network problem.
  ca-certificates
  libx264-164
  libx265-199
  libvpx9
  libaom3
  libdav1d7
  libopus0
  libmp3lame0
  libvorbis0a
  libvorbisenc2
  libwebp7
  libwebpmux3
  libzimg2
  libass9
  libfreetype6
  libfribidi0
  libharfbuzz0b
  libva2
  libva-drm2
  mesa-va-drivers
  libdrm2
  zlib1g
)
