{
  "name": "@clipmux/player",
  "version": "0.1.2",
  "description": "ClipMux video player \u2014 drop-in React component with built-in analytics",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "~3.2.7"
  },
  "keywords": [
    "video",
    "player",
    "hls",
    "clipmux",
    "vidstack",
    "react",
    "analytics",
    "streaming"
  ],
  "license": "MIT",
  "dependencies": {
    "@vidstack/react": "^1.12.13"
  }
}