{
  "name": "openvod",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "dev:workers": "node scripts/dev.mjs dev:workers",
    "dev:all": "node scripts/dev.mjs dev:all",
    "dev:cleanup": "node scripts/dev.mjs cleanup",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:reset": "docker compose -f docker-compose.dev.yml down -v",
    "start": "pnpm start:prepare && node scripts/dev.mjs start",
    "start:prepare": "pnpm --filter vod-api build:node && pnpm --filter web build",
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "test:server": "pnpm --filter vod-api test",
    "test:delivery": "pnpm --filter ./delivery test",
    "test:sdk": "pnpm --filter ./sdk test",
    "test:player": "pnpm --filter ./player test",
    "test:setup": "pnpm --filter openvod-setup test",
    "test:python": "cd transcoding && .venv/bin/python -m pytest",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "typecheck:tsc": "pnpm --filter vod-api exec tsc --noEmit && pnpm --filter ./delivery exec tsc --noEmit",
    "bootstrap": "bash scripts/bootstrap.sh",
    "setup": "bash scripts/bootstrap.sh",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait postgres",
    "db:down": "docker compose -f docker-compose.dev.yml stop postgres",
    "db:push": "pnpm --filter vod-api db:push",
    "db:migrate": "pnpm --filter vod-api db:migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v"
  }
}
