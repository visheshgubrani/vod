# OpenVOD — DEPLOYMENT configuration (docker compose).
#
#   cp .env.example .env
#   # edit: secrets, public URLs, R2 buckets
#   docker compose run --rm migrate
#   docker compose up -d
#
# This file configures the stack in docker-compose.yml — the end-user
# deployment, and how we test a deployment. Compose reads `.env` twice: for
# `${...}` interpolation in the compose file, and as the environment of the
# `api` / `maintenance` containers.
#
# DEVELOPING OpenVOD? You do not need this file. Local development uses:
#   server/.dev.vars     API config (docs: server/.dev.vars.example)
#   delivery/.dev.vars   delivery worker config
#   web/.env             dashboard config
# and starts its containers from docker-compose.dev.yml (Postgres + Redis only):
#   pnpm dev:infra && pnpm db:migrate && pnpm dev
# See CONTRIBUTING.md.
#
# Full reference: docs/deployment-shapes.md. Validate without starting anything:
#   docker compose config --quiet

# ── Stack wiring ───────────────────────────────────────────────────────────
# The bundled Postgres. Change these *and* the DATABASE_URL below together, or
# point DATABASE_URL at an external server and ignore them.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=openvod

# Leave DATABASE_URL unset to use the bundled Postgres (the compose file
# composes it from the three values above). Set it to use your own:
#   DATABASE_URL=postgresql://user:pass@db.example.com:5432/openvod?sslmode=require
DATABASE_URL=
DB_DRIVER=pg

# Leave unset to use the bundled Redis. Set it to use your own (or leave both
# unset and *and* remove the service to fall back to the in-memory limiter,
# which is per-instance):
#   REDIS_URL=redis://default:password@redis.example.com:6379
REDIS_URL=

# Host ports (bound to 127.0.0.1 — put a reverse proxy in front for public
# traffic). These collide with `pnpm dev`, so run the dev stack or this one.
OPENVOD_API_PORT=8787
OPENVOD_WEB_PORT=3000

# Optional: pin images instead of building locally, e.g. when deploying with
# `docker compose pull` from a registry.
# OPENVOD_API_IMAGE=ghcr.io/your-org/openvod-server:latest
# OPENVOD_WEB_IMAGE=ghcr.io/your-org/openvod-web:latest

# ── Public origins the browser will use ────────────────────────────────────
# These are baked into the dashboard bundle at BUILD time (Next.js inlines
# NEXT_PUBLIC_*), so changing them requires a rebuild:
#   docker compose build web && docker compose up -d web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787/api
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:8787/api/auth
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# Server-side origin config. FRONTEND_URL/CORS_ORIGINS are the CORS allowlist
# (`*.example.com` wildcards supported); BACKEND_URL is the API's own public
# origin, used to build the transcode callback URL.
BETTER_AUTH_URL=http://localhost:8787
BACKEND_URL=http://localhost:8787
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=

# ── Secrets (generate each one: openssl rand -hex 32) ──────────────────────
BETTER_AUTH_SECRET=change-me-at-least-32-characters-long
JWT_SECRET=change-me-at-least-32-characters-long
# Shared with the Modal app / the transcoder agent. Required for the transcode
# callback to authenticate; dispatch and verification use this same value.
TRANSCODE_INGEST_SECRET=change-me-long-random-string
# Required by the maintenance service to call POST /api/internal/sweep.
INTERNAL_SWEEP_SECRET=change-me-long-random-string
# Runs transcode sweeps, webhook retries and storage reclamation. Leaving this
# off is not inert: failed webhooks are never retried and deleted videos keep
# their bytes forever.
SWEEP_ENABLED=true
MAINTENANCE_INTERVAL_SECONDS=900

# ── Cloudflare R2 (storage — fixed provider) ───────────────────────────────
ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Required only when uploads are enabled or the provider is Modal; a local-only
# installation (self-hosted provider + UPLOADS_ENABLED=false) may leave it blank.
RAW_BUCKET_NAME=
TRANSCODED_BUCKET_NAME=
# Optional: playback/bandwidth stats read the Analytics Engine SQL API.
CLOUDFLARE_ANALYTICS_TOKEN=

# ── Delivery (fixed: always the Cloudflare Worker + R2) ────────────────────
# Public origin of the deployed delivery worker. Without it, signed playback
# URLs are returned relative.
DELIVERY_URL=

# ── Transcoding ────────────────────────────────────────────────────────────
# "modal" (default) or "self-hosted". Stored per job, so changing it never
# reroutes work that already exists.
TRANSCODE_PROVIDER=modal
# Set to "false" to stop accepting NEW self-hosted submissions while accepted
# jobs drain. It never moves a local file to Modal.
SELF_HOSTED_ENABLED=
# Whether browser/SDK uploads are accepted. Turning it off makes a raw bucket
# unnecessary.
UPLOADS_ENABLED=true
# Required only when TRANSCODE_PROVIDER=modal.
MODAL_WEBHOOK_URL=

# ── Optional integrations ──────────────────────────────────────────────────
# Durable queueing for transcode dispatch. Unset = direct HTTPS to the Modal
# endpoint, which needs no extra vendor.
QSTASH_TOKEN=
# Shared store for rate limits across replicas. Unset = the bundled Redis above
# when REDIS_URL is set, otherwise Upstash REST, otherwise in-memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# AI subtitles/chapters.
GROQ_API_KEY=
# OAuth login. Leave empty for email/password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Cost controls (optional) ───────────────────────────────────────────────
# Max concurrent transcode attempts per organization. Unset = unlimited.
TRANSCODE_ORG_CONCURRENCY_CAP=
MAX_UPLOAD_SIZE_BYTES=

# ── Self-hosted transcoder agent (compose profile "transcoder") ────────────
#   docker compose --profile transcoder up -d
# OPENVOD_AGENT_TOKEN is minted by the dashboard pairing flow.
OPENVOD_AGENT_TOKEN=
OPENVOD_ROOTS=media:/media
OPENVOD_MEDIA_DIR=./media
OPENVOD_CAPACITY_JOBS=1
OPENVOD_CAPACITY_RENDITIONS=1
OPENVOD_ENCODER=auto

# ── Local-only installation (no R2 raw bucket, no Modal, no QStash) ────────
#   TRANSCODE_PROVIDER=self-hosted
#   UPLOADS_ENABLED=false
#   # leave RAW_BUCKET_NAME and MODAL_WEBHOOK_URL unset
# Then pair an agent: docker compose run --rm transcoder pair --api http://api:4080 --code <CODE>
