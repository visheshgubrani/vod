# =========================================================
# OpenVOD — root ignore file
# Per-package ignores live in each package; this catches
# anything that falls between them.
# =========================================================

# dependencies
node_modules/
.pnpm-store/

# builds & caches
dist/
.next/
out/
*.tsbuildinfo
.parcel-cache/
.cache/

# python
__pycache__/
*.pyc
.venv/

# environment & secrets (keep committed examples)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
secrets.json

# cloudflare / wrangler
.wrangler/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# misc
.DS_Store
coverage/
*.tgz
.npmrc
.pnpm-cache/

# pnpm store farm occasionally materializes at clipmux-docs/ root (root cause
# TBD); keep the real project files only.
clipmux-docs/*
!clipmux-docs/app/
!clipmux-docs/components/
!clipmux-docs/content/
!clipmux-docs/lib/
!clipmux-docs/package.json
!clipmux-docs/next.config.mjs
!clipmux-docs/postcss.config.mjs
!clipmux-docs/source.config.ts
!clipmux-docs/tsconfig.json
!clipmux-docs/eslint.config.mjs
!clipmux-docs/mdx-components.tsx
!clipmux-docs/README.md
!clipmux-docs/.gitignore
