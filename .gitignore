# =========================================================
# OpenVOD — root ignore file
# Per-package ignores live in each package; this catches
# anything that falls between them.
# =========================================================

# dependencies
node_modules/
.pnpm-store/

# builds & caches
dist/
.next/
out/
*.tsbuildinfo
.parcel-cache/
.cache/

# python
__pycache__/
*.pyc
.venv/

# environment & secrets (keep committed examples)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example
secrets.json

# cloudflare / wrangler
.wrangler/

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# misc
.DS_Store
coverage/
*.tgz
.npmrc
.pnpm-cache/

# pnpm store farm occasionally materializes at docs-site/ root (root cause
# TBD); keep the real project files only.
docs-site/*
!docs-site/app/
!docs-site/components/
!docs-site/content/
!docs-site/lib/
!docs-site/package.json
!docs-site/next.config.mjs
!docs-site/postcss.config.mjs
!docs-site/source.config.ts
!docs-site/tsconfig.json
!docs-site/eslint.config.mjs
!docs-site/mdx-components.tsx
!docs-site/README.md
!docs-site/.gitignore
